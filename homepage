<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>教師數位名片 & 教學資源中心</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts (Noto Sans TC 與 Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <!-- 引入 FontAwesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
                    },
                    animation: {
                        'blob': 'blob 7s infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* 隱藏水平捲軸但保留滑動功能 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen relative overflow-x-hidden selection:bg-emerald-500 selection:text-white transition-colors duration-300">

    <!-- 背景動態流體光暈 (調整為學院墨綠與暖陽琥珀色調，營造書卷與溫暖氛圍) -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-emerald-600/25 rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob"></div>
        <div class="absolute top-[20%] right-[-10%] w-96 h-96 bg-amber-500/20 rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-[-10%] left-[20%] w-96 h-96 bg-teal-600/20 rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- 頂部控制列 -->
    <nav class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 pt-6 pb-2 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-400 animate-pulse"></span>
            <span class="text-xs font-medium tracking-wider text-slate-300" id="status-badge">教學交流與課程諮詢開放中</span>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
            <!-- 分享按鈕 -->
            <button onclick="copyProfileSummary()" class="p-2.5 sm:px-4 sm:py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-medium transition-all flex items-center gap-2 active:scale-95" title="複製老師名片與課程連結">
                <i class="fa-solid fa-share-nodes text-amber-400"></i>
                <span class="hidden sm:inline">分享教師名片</span>
            </button>
            <!-- 編輯模式切換按鈕 -->
            <button id="toggle-edit-btn" onclick="toggleEditMode()" class="p-2.5 sm:px-4 sm:py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium shadow-lg shadow-emerald-500/25 transition-all flex items-center gap-2 active:scale-95">
                <i class="fa-solid fa-pen-to-square" id="edit-icon"></i>
                <span id="edit-btn-text">編輯主頁</span>
            </button>
        </div>
    </nav>

    <!-- 主要內容區：Bento Grid 便當盒佈局 -->
    <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
            
            <!-- 1. 核心教師簡介卡片 (移除右側公告欄後，自動延伸佔滿 12 欄) -->
            <section class="md:col-span-12 rounded-3xl bg-white/[0.04] backdrop-blur-xl border border-white/10 p-6 sm:p-8 flex flex-col justify-between relative group transition-all hover:border-emerald-500/30">
                <!-- 編輯個人資料按鈕 (僅在編輯模式顯示) -->
                <button onclick="openProfileModal()" class="edit-only hidden absolute top-5 right-5 px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/40 border border-emerald-400/30 text-emerald-300 text-xs font-medium transition-all flex items-center gap-1.5">
                    <i class="fa-solid fa-sliders"></i> 修改教師檔案
                </button>

                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
                    <!-- 頭像區 (點擊亦可快速開啟上傳視窗) -->
                    <div class="relative shrink-0 group/avatar cursor-pointer" onclick="openProfileModal()" title="點擊更換個人相片">
                        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden ring-2 ring-emerald-500/50 p-1 bg-gradient-to-tr from-emerald-500 via-teal-400 to-amber-400 relative">
                            <img id="profile-avatar" src="https://placehold.co/400x400/064e3b/34d399?text=Teacher" 
                                 onerror="this.src='https://placehold.co/400x400/064e3b/34d399?text=Teacher'" 
                                 alt="教師頭像" class="w-full h-full object-cover rounded-xl">
                            <!-- 懸停上傳提示遮罩 -->
                            <div class="absolute inset-1 rounded-xl bg-slate-950/60 opacity-0 group-hover/avatar:opacity-100 transition-opacity flex flex-col items-center justify-center text-white text-xs gap-1">
                                <i class="fa-solid fa-camera text-base text-amber-300"></i>
                                <span>上傳相片</span>
                            </div>
                        </div>
                        <div class="absolute -bottom-2 -right-2 bg-slate-900 border border-white/10 rounded-xl px-2 py-1 text-base shadow-lg animate-float" id="profile-emoji">
                            🍎
                        </div>
                    </div>

                    <!-- 姓名與任教科目頭銜 -->
                    <div class="flex-1">
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-2" id="profile-role">
                            專任教師 / 數位教學推手 / 班級導師
                        </div>
                        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-amber-100 to-emerald-200" id="profile-name">
                            陳思妤 老師 (Miss Chen)
                        </h1>
                        <p class="text-slate-400 text-sm mt-1.5 flex items-center gap-2">
                            <i class="fa-solid fa-school text-amber-400"></i>
                            <span id="profile-location">台南 · 陽光創新學苑 / 課程研發組</span>
                        </p>
                    </div>
                </div>

                <!-- 教育理念與自我介紹內文 -->
                <div class="mt-6 relative pl-4 border-l-2 border-amber-400/60">
                    <p class="text-slate-200 leading-relaxed text-sm sm:text-base" id="profile-bio">
                        「教育不是注滿一桶水，而是點燃一把火。」我是熱愛將科技與生活融入課堂的老師！致力於打造有溫度、能互動的學習環境，陪伴每位學生發掘自己的閃光點。歡迎同學與家長透過下方的連結下載課程講義、使用課堂互動工具，或隨時與我聯繫！
                    </p>
                </div>

                <!-- 教學專長標籤雲 -->
                <div class="mt-6 flex flex-wrap gap-2" id="profile-tags">
                    <span class="px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200">#探究與實作</span>
                    <span class="px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200">#數位雙語教學</span>
                    <span class="px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200">#班級經營</span>
                    <span class="px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200">#閱讀素養</span>
                </div>
            </section>

            <!-- 2. 教學資源、課程連結 & 數位教室區塊 (佔滿 12 欄) -->
            <section class="md:col-span-12 rounded-3xl bg-white/[0.03] backdrop-blur-xl border border-white/10 p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-book-open"></i>
                            </span>
                            教學資源與數位教室傳送門
                        </h2>
                        <p class="text-slate-400 text-xs sm:text-sm mt-1">點擊卡片前往課程平台或下載講義；點選右側按鈕可隨時新增教學網頁連結</p>
                    </div>

                    <!-- 新增連結按鈕 -->
                    <button onclick="openLinkModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-sm font-semibold shadow-lg shadow-emerald-500/25 transition-all flex items-center justify-center gap-2 active:scale-95 shrink-0">
                        <i class="fa-solid fa-plus"></i>
                        <span>新增教學連結</span>
                    </button>
                </div>

                <!-- 教師專屬分類過濾器 -->
                <div class="flex gap-2 overflow-x-auto pb-3 mb-4 no-scrollbar" id="category-filters">
                    <button onclick="filterLinks('all')" data-cat="all" class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-medium bg-amber-400 text-slate-950 font-bold transition-all shrink-0">全部資源</button>
                    <button onclick="filterLinks('course')" data-cat="course" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white/5 text-slate-300 hover:bg-white/10 transition-all shrink-0">📚 課程講義與作業</button>
                    <button onclick="filterLinks('tool')" data-cat="tool" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white/5 text-slate-300 hover:bg-white/10 transition-all shrink-0">💻 課堂互動工具</button>
                    <button onclick="filterLinks('article')" data-cat="article" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white/5 text-slate-300 hover:bg-white/10 transition-all shrink-0">✍️ 教學筆記與分享</button>
                    <button onclick="filterLinks('contact')" data-cat="contact" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white/5 text-slate-300 hover:bg-white/10 transition-all shrink-0">📢 班級與親師聯絡</button>
                </div>

                <!-- 連結卡片網格容器 -->
                <div id="links-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- 動態由 JavaScript 渲染連結卡片 -->
                </div>
            </section>

            <!-- 4. 數據備份與重置區 (僅在編輯模式顯示) -->
            <section class="edit-only hidden md:col-span-12 rounded-3xl bg-amber-500/10 border border-amber-500/20 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3 text-amber-200 text-sm">
                    <i class="fa-solid fa-circle-info text-lg text-amber-400"></i>
                    <span>你目前處於<strong>編輯模式</strong>，所有修改都會自動儲存在你的瀏覽器中。</span>
                </div>
                <div class="flex gap-2 w-full sm:w-auto justify-end">
                    <button onclick="exportData()" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-medium text-white transition-all">
                        <i class="fa-solid fa-download mr-1"></i> 匯出設定檔
                    </button>
                    <button onclick="resetToDefault()" class="px-3.5 py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-xs font-medium text-rose-300 transition-all">
                        <i class="fa-solid fa-rotate-left mr-1"></i> 恢復預設
                    </button>
                </div>
            </section>

        </div>
    </main>

    <!-- 頁尾 -->
    <footer class="relative z-10 max-w-5xl mx-auto px-4 py-8 text-center text-slate-500 text-xs">
        <p>© <span id="year"></span> <span id="footer-name">陳思妤 老師</span> · 打造有溫度的數位教學空間</p>
    </footer>

    <!-- ==================== 彈出視窗 1：新增/編輯教學網頁連結 ==================== -->
    <div id="link-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm">
        <div class="bg-slate-900 border border-white/15 rounded-3xl w-full max-w-md p-6 shadow-2xl transform transition-all">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold text-white" id="link-modal-title">新增教學網頁連結</h3>
                <button onclick="closeLinkModal()" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="link-form" onsubmit="saveLink(event)" class="space-y-4">
                <input type="hidden" id="link-id">
                
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1.5">資源 / 網頁標題 *</label>
                    <input type="text" id="link-title" required placeholder="例如：Google Classroom 線上教室" 
                           class="w-full px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500 transition-colors">
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1.5">網頁連結 (URL) *</label>
                    <input type="url" id="link-url" required placeholder="https://classroom.google.com" 
                           class="w-full px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500 transition-colors">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1.5">資源分類</label>
                        <select id="link-category" class="w-full px-3 py-2.5 rounded-xl bg-slate-800 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500">
                            <option value="course">📚 課程講義與作業</option>
                            <option value="tool">💻 課堂互動工具</option>
                            <option value="article">✍️ 教學筆記與分享</option>
                            <option value="contact">📢 班級與親師聯絡</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1.5">代表圖示 (Emoji)</label>
                        <input type="text" id="link-icon" placeholder="📖" maxlength="4" value="📖"
                               class="w-full px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm text-center focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1.5">給學生/家長的說明</label>
                    <textarea id="link-desc" rows="2" placeholder="例如：請同學於週五前完成線上測驗..." 
                              class="w-full px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500 transition-colors"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1.5">卡片強調色</label>
                    <div class="flex gap-2.5" id="color-picker">
                        <label class="cursor-pointer">
                            <input type="radio" name="link-color" value="emerald" class="sr-only peer" checked>
                            <span class="block w-7 h-7 rounded-full bg-emerald-500 ring-2 ring-transparent peer-checked:ring-white transition-all"></span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="link-color" value="amber" class="sr-only peer">
                            <span class="block w-7 h-7 rounded-full bg-amber-500 ring-2 ring-transparent peer-checked:ring-white transition-all"></span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="link-color" value="cyan" class="sr-only peer">
                            <span class="block w-7 h-7 rounded-full bg-cyan-500 ring-2 ring-transparent peer-checked:ring-white transition-all"></span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="link-color" value="rose" class="sr-only peer">
                            <span class="block w-7 h-7 rounded-full bg-rose-500 ring-2 ring-transparent peer-checked:ring-white transition-all"></span>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="link-color" value="indigo" class="sr-only peer">
                            <span class="block w-7 h-7 rounded-full bg-indigo-500 ring-2 ring-transparent peer-checked:ring-white transition-all"></span>
                        </label>
                    </div>
                </div>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="closeLinkModal()" class="flex-1 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium transition-colors">取消</button>
                    <button type="submit" class="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold shadow-lg shadow-emerald-500/25 transition-colors">儲存連結</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==================== 彈出視窗 2：編輯教師個人資料 ==================== -->
    <div id="profile-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm overflow-y-auto">
        <div class="bg-slate-900 border border-white/15 rounded-3xl w-full max-w-lg p-6 shadow-2xl my-8">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold text-white">編輯教師個人檔案</h3>
                <button onclick="closeProfileModal()" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="profile-form" onsubmit="saveProfile(event)" class="space-y-4">
                <!-- 個人相片上傳區 -->
                <div class="flex items-center gap-4 p-3.5 rounded-2xl bg-white/[0.03] border border-white/10">
                    <img id="preview-avatar" src="https://placehold.co/400x400/064e3b/34d399?text=Teacher" alt="相片預覽" class="w-16 h-16 rounded-xl object-cover ring-2 ring-emerald-500/40 shrink-0">
                    <div class="flex-1">
                        <label class="block text-xs font-medium text-slate-300 mb-1.5">個人相片 (從電腦或手機上傳)</label>
                        <div class="flex flex-wrap items-center gap-2">
                            <label class="cursor-pointer px-3.5 py-2 rounded-xl bg-emerald-600/25 hover:bg-emerald-600/40 border border-emerald-500/30 text-emerald-300 text-xs font-medium transition-all inline-flex items-center gap-1.5">
                                <i class="fa-solid fa-upload"></i>
                                <span>選擇相片檔案</span>
                                <input type="file" id="input-avatar-file" accept="image/*" onchange="handleAvatarUpload(event)" class="hidden">
                            </label>
                            <span id="upload-file-name" class="text-[11px] text-slate-400 truncate max-w-[160px]">支援 JPG、PNG 格式</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-slate-400 mb-1">教師姓名 / 稱呼</label>
                        <input type="text" id="input-name" required class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">代表徽章 (Emoji)</label>
                        <input type="text" id="input-emoji" maxlength="4" class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm text-center focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">任教科目 / 職稱</label>
                        <input type="text" id="input-role" class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">任教學校 / 辦公室</label>
                        <input type="text" id="input-location" class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">教育理念與自我介紹</label>
                    <textarea id="input-bio" rows="3" class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">教學專長標籤 (用逗號分隔)</label>
                    <input type="text" id="input-tags" placeholder="雙語教學, 專題探究, 班級經營" class="w-full px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-emerald-500">
                </div>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="closeProfileModal()" class="flex-1 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-medium">取消</button>
                    <button type="submit" class="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold shadow-lg shadow-emerald-500/25">更新檔案</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 自訂 Toast 提示訊息框 -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-2xl bg-slate-900/95 border border-white/15 text-white text-sm font-medium shadow-2xl flex items-center gap-2.5 opacity-0 translate-y-4 pointer-events-none transition-all duration-300">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-msg">操作成功！</span>
    </div>

    <!-- JavaScript 邏輯 -->
    <script>
        // 教師專屬預設資料結構 (清空預設連結與右側公告)
        const defaultData = {
            profile: {
                name: "陳思妤 老師 (Miss Chen)",
                emoji: "🍎",
                avatar: "https://placehold.co/400x400/064e3b/34d399?text=Teacher",
                role: "專任教師 / 數位教學推手 / 班級導師",
                location: "台南 · 陽光創新學苑 / 課程研發組",
                bio: "「教育不是注滿一桶水，而是點燃一把火。」我是熱愛將科技與生活融入課堂的老師！致力於打造有溫度、能互動的學習環境，陪伴每位學生發掘自己的閃光點。歡迎同學與家長透過下方的連結下載課程講義、使用課堂互動工具，或隨時與我聯繫！",
                tags: ["探究與實作", "數位雙語教學", "班級經營", "閱讀素養"]
            },
            links: []
        };

        // 狀態管理 (更新儲存鍵值 v2 以套用乾淨初始狀態)
        let appData = JSON.parse(localStorage.getItem('teacherPortalData_v2')) || JSON.parse(JSON.stringify(defaultData));
        let isEditMode = false;
        let currentFilter = 'all';
        let uploadedAvatarDataUrl = '';

        // 顏色映射表
        const colorStyles = {
            emerald: { bg: 'bg-emerald-500/10', border: 'hover:border-emerald-500/50', text: 'text-emerald-400', badge: 'bg-emerald-500/20 text-emerald-300' },
            amber: { bg: 'bg-amber-500/10', border: 'hover:border-amber-500/50', text: 'text-amber-400', badge: 'bg-amber-500/20 text-amber-300' },
            cyan: { bg: 'bg-cyan-500/10', border: 'hover:border-cyan-500/50', text: 'text-cyan-400', badge: 'bg-cyan-500/20 text-cyan-300' },
            rose: { bg: 'bg-rose-500/10', border: 'hover:border-rose-500/50', text: 'text-rose-400', badge: 'bg-rose-500/20 text-rose-300' },
            indigo: { bg: 'bg-indigo-500/10', border: 'hover:border-indigo-500/50', text: 'text-indigo-400', badge: 'bg-indigo-500/20 text-indigo-300' }
        };

        const categoryNames = {
            course: '課程講義',
            tool: '互動工具',
            article: '教學筆記',
            contact: '親師聯絡'
        };

        // 初始化頁面
        function init() {
            document.getElementById('year').textContent = new Date().getFullYear();
            renderProfile();
            renderLinks();
        }

        // 儲存資料至 LocalStorage
        function persistData() {
            try {
                localStorage.setItem('teacherPortalData_v2', JSON.stringify(appData));
            } catch (e) {
                showToast('儲存失敗，相片檔案可能過大，請選擇較小的圖片', true);
            }
        }

        // 渲染個人資料
        function renderProfile() {
            const p = appData.profile;
            document.getElementById('profile-name').textContent = p.name;
            document.getElementById('footer-name').textContent = p.name;
            document.getElementById('profile-emoji').textContent = p.emoji || '🍎';
            document.getElementById('profile-avatar').src = p.avatar;
            document.getElementById('profile-role').textContent = p.role;
            document.getElementById('profile-location').textContent = p.location;
            document.getElementById('profile-bio').textContent = p.bio;

            const tagsContainer = document.getElementById('profile-tags');
            tagsContainer.innerHTML = p.tags.map(tag => 
                `<span class="px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200">#${escapeHTML(tag.trim())}</span>`
            ).join('');
        }
        // ==================== 個人資料 Modal 與相片上傳操作 ====================
        function handleAvatarUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                showToast('請選擇圖片格式的檔案（如 JPG、PNG）', true);
                return;
            }

            document.getElementById('upload-file-name').textContent = file.name;

            // 使用 Canvas 適度壓縮並轉為 DataURL，確保能順利儲存在瀏覽器中
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const maxSize = 400;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > maxSize) {
                            height *= maxSize / width;
                            width = maxSize;
                        }
                    } else {
                        if (height > maxSize) {
                            width *= maxSize / height;
                            height = maxSize;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    uploadedAvatarDataUrl = canvas.toDataURL('image/jpeg', 0.85);
                    document.getElementById('preview-avatar').src = uploadedAvatarDataUrl;
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function openProfileModal() {
            const p = appData.profile;
            uploadedAvatarDataUrl = p.avatar;
            document.getElementById('preview-avatar').src = p.avatar;
            document.getElementById('input-avatar-file').value = '';
            document.getElementById('upload-file-name').textContent = '支援 JPG、PNG 格式';
            document.getElementById('input-name').value = p.name;
            document.getElementById('input-emoji').value = p.emoji;
            document.getElementById('input-role').value = p.role;
            document.getElementById('input-location').value = p.location;
            document.getElementById('input-bio').value = p.bio;
            document.getElementById('input-tags').value = p.tags.join(', ');

            const modal = document.getElementById('profile-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeProfileModal() {
            const modal = document.getElementById('profile-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveProfile(e) {
            e.preventDefault();
            appData.profile = {
                name: document.getElementById('input-name').value.trim(),
                emoji: document.getElementById('input-emoji').value.trim() || '🍎',
                avatar: uploadedAvatarDataUrl || defaultData.profile.avatar,
                role: document.getElementById('input-role').value.trim(),
                location: document.getElementById('input-location').value.trim(),
                bio: document.getElementById('input-bio').value.trim(),
                tags: document.getElementById('input-tags').value.split(/[,，]/).map(t => t.trim()).filter(Boolean)
            };

            persistData();
            renderProfile();
            closeProfileModal();
            showToast('教師個人檔案與相片已更新！');
        }

        // 渲染教學資源連結卡片
        function renderLinks() {
            const grid = document.getElementById('links-grid');
            const filtered = currentFilter === 'all' 
                ? appData.links 
                : appData.links.filter(item => item.category === currentFilter);

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center border border-dashed border-white/15 rounded-2xl bg-white/[0.01]">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center text-xl mx-auto mb-3">
                            <i class="fa-solid fa-folder-plus"></i>
                        </div>
                        <p class="text-slate-300 text-sm font-medium">目前還沒有任何教學資源連結</p>
                        <p class="text-slate-500 text-xs mt-1">點擊下方按鈕，開始建立您的第一個課程或班級網頁連結</p>
                        <button onclick="openLinkModal()" class="mt-4 px-4 py-2 rounded-xl bg-emerald-600/25 hover:bg-emerald-600/40 border border-emerald-500/30 text-emerald-300 text-xs font-medium transition-all inline-flex items-center gap-1.5">
                            <i class="fa-solid fa-plus"></i> 立即新增第一個教學連結
                        </button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(link => {
                const style = colorStyles[link.color] || colorStyles.emerald;
                const domain = extractDomain(link.url);

                return `
                <div class="group relative rounded-2xl bg-white/[0.04] hover:bg-white/[0.07] border border-white/10 ${style.border} p-5 transition-all duration-300 flex flex-col justify-between hover:-translate-y-1 hover:shadow-xl">
                    <!-- 編輯與刪除控制鈕 (僅在編輯模式顯示) -->
                    <div class="${isEditMode ? 'flex' : 'hidden'} absolute top-3 right-3 gap-1.5 z-10">
                        <button onclick="openLinkModal('${link.id}')" class="w-8 h-8 rounded-lg bg-slate-800/90 hover:bg-emerald-600 text-slate-300 hover:text-white border border-white/10 flex items-center justify-center text-xs transition-colors" title="編輯連結">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="deleteLink('${link.id}')" class="w-8 h-8 rounded-lg bg-slate-800/90 hover:bg-rose-600 text-slate-300 hover:text-white border border-white/10 flex items-center justify-center text-xs transition-colors" title="刪除連結">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>

                    <a href="${escapeHTML(link.url)}" target="_blank" rel="noopener noreferrer" class="block h-full flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-3 mb-3">
                                <div class="w-11 h-11 rounded-xl ${style.bg} border border-white/10 flex items-center justify-center text-xl shrink-0">
                                    ${escapeHTML(link.icon || '📖')}
                                </div>
                                <span class="px-2.5 py-1 rounded-lg text-[11px] font-medium ${style.badge}">
                                    ${categoryNames[link.category] || '教學資源'}
                                </span>
                            </div>
                            <h3 class="text-base font-bold text-white group-hover:text-amber-200 transition-colors line-clamp-1">
                                ${escapeHTML(link.title)}
                            </h3>
                            <p class="text-slate-400 text-xs mt-1.5 line-clamp-2 leading-relaxed">
                                ${escapeHTML(link.desc || '點擊前往查看課程資源')}
                            </p>
                        </div>

                        <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-slate-500">
                            <span class="truncate max-w-[180px]">${escapeHTML(domain)}</span>
                            <span class="w-6 h-6 rounded-full bg-white/5 group-hover:bg-emerald-500 group-hover:text-white flex items-center justify-center transition-all">
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </span>
                        </div>
                    </a>
                </div>
                `;
            }).join('');
        }

        // 分類過濾切換
        function filterLinks(category) {
            currentFilter = category;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.dataset.cat === category) {
                    btn.className = 'filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold bg-amber-400 text-slate-950 transition-all shrink-0';
                } else {
                    btn.className = 'filter-btn px-3.5 py-1.5 rounded-xl text-xs font-medium bg-white/5 text-slate-300 hover:bg-white/10 transition-all shrink-0';
                }
            });
            renderLinks();
        }

        // 切換編輯模式
        function toggleEditMode() {
            isEditMode = !isEditMode;
            const btnText = document.getElementById('edit-btn-text');
            const editIcon = document.getElementById('edit-icon');
            const editBtn = document.getElementById('toggle-edit-btn');

            if (isEditMode) {
                btnText.textContent = '完成編輯';
                editIcon.className = 'fa-solid fa-check';
                editBtn.classList.replace('bg-emerald-600', 'bg-amber-500');
                editBtn.classList.replace('hover:bg-emerald-500', 'hover:bg-amber-400');
                editBtn.classList.replace('text-white', 'text-slate-950');
                document.querySelectorAll('.edit-only').forEach(el => el.classList.remove('hidden'));
                showToast('已進入編輯模式，可修改教師檔案與資源連結');
            } else {
                btnText.textContent = '編輯主頁';
                editIcon.className = 'fa-solid fa-pen-to-square';
                editBtn.classList.replace('bg-amber-500', 'bg-emerald-600');
                editBtn.classList.replace('hover:bg-amber-400', 'hover:bg-emerald-500');
                editBtn.classList.replace('text-slate-950', 'text-white');
                document.querySelectorAll('.edit-only').forEach(el => el.classList.add('hidden'));
                showToast('所有變更已儲存');
            }
            renderLinks();
        }

        // ==================== 連結 Modal 操作 ====================
        function openLinkModal(id = null) {
            const modal = document.getElementById('link-modal');
            const form = document.getElementById('link-form');
            form.reset();

            if (id) {
                const link = appData.links.find(l => l.id === id);
                if (!link) return;
                document.getElementById('link-modal-title').textContent = '編輯教學網頁連結';
                document.getElementById('link-id').value = link.id;
                document.getElementById('link-title').value = link.title;
                document.getElementById('link-url').value = link.url;
                document.getElementById('link-category').value = link.category;
                document.getElementById('link-icon').value = link.icon;
                document.getElementById('link-desc').value = link.desc;
                const radio = document.querySelector(`input[name="link-color"][value="${link.color}"]`);
                if (radio) radio.checked = true;
            } else {
                document.getElementById('link-modal-title').textContent = '新增教學網頁連結';
                document.getElementById('link-id').value = '';
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeLinkModal() {
            const modal = document.getElementById('link-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveLink(e) {
            e.preventDefault();
            const id = document.getElementById('link-id').value;
            const title = document.getElementById('link-title').value.trim();
            let url = document.getElementById('link-url').value.trim();
            if (!url.startsWith('http://') && !url.startsWith('https://')) {
                url = 'https://' + url;
            }
            const category = document.getElementById('link-category').value;
            const icon = document.getElementById('link-icon').value.trim() || '🌐';
            const desc = document.getElementById('link-desc').value.trim();
            const color = document.querySelector('input[name="link-color"]:checked').value;

            if (id) {
                const index = appData.links.findIndex(l => l.id === id);
                if (index !== -1) {
                    appData.links[index] = { id, title, url, category, icon, desc, color };
                    showToast('連結已更新！');
                }
            } else {
                const newLink = {
                    id: Date.now().toString(),
                    title, url, category, icon, desc, color
                };
                appData.links.unshift(newLink);
                showToast('已成功新增網頁連結！');
            }

            persistData();
            renderLinks();
            closeLinkModal();
        }

        function deleteLink(id) {
            appData.links = appData.links.filter(l => l.id !== id);
            persistData();
            renderLinks();
            showToast('連結已刪除');
        }

        // ==================== 實用工具函式 ====================
        // 複製個人名片摘要 (使用 execCommand 相容 iframe 環境)
        function copyProfileSummary() {
            const p = appData.profile;
            const linksText = appData.links.length > 0 
                ? appData.links.map(l => `• ${l.title}: ${l.url}`).join('\n')
                : '（尚未新增課程連結）';
            const summary = `【${p.name}】${p.role}\n${p.bio}\n\n🔗 教學資源連結：\n${linksText}`;
            document.getElementById('input-bio').value = p.bio;
            document.getElementById('input-tags').value = p.tags.join(', ');
            document.getElementById('input-focus').value = p.focus;

            const modal = document.getElementById('profile-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeProfileModal() {
            const modal = document.getElementById('profile-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveProfile(e) {
            e.preventDefault();
            appData.profile = {
                name: document.getElementById('input-name').value.trim(),
                emoji: document.getElementById('input-emoji').value.trim() || '✨',
                avatar: document.getElementById('input-avatar').value.trim() || defaultData.profile.avatar,
                role: document.getElementById('input-role').value.trim(),
                location: document.getElementById('input-location').value.trim(),
                bio: document.getElementById('input-bio').value.trim(),
                tags: document.getElementById('input-tags').value.split(/[,，]/).map(t => t.trim()).filter(Boolean),
                focus: document.getElementById('input-focus').value.trim()
            };

            persistData();
            renderProfile();
            closeProfileModal();
            showToast('個人資料已更新！');
        }

        // ==================== 實用工具函式 ====================
        // 複製個人名片摘要 (使用 execCommand 相容 iframe 環境)
        function copyProfileSummary() {
            const p = appData.profile;
            const linksText = appData.links.map(l => `• ${l.title}: ${l.url}`).join('\n');
            const summary = `【${p.name}】${p.role}\n${p.bio}\n\n🔗 精選連結：\n${linksText}`;

            const textarea = document.createElement('textarea');
            textarea.value = summary;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('已複製個人名片與所有連結到剪貼簿！');
            } catch (err) {
                showToast('複製失敗，請手動選取複製', true);
            }
            document.body.removeChild(textarea);
        }

        // 匯出 JSON 設定檔
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "my-personal-page-backup.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('已匯出個人網頁設定檔！');
        }

        // 恢復預設資料
        function resetToDefault() {
            appData = JSON.parse(JSON.stringify(defaultData));
            persistData();
            renderProfile();
            renderLinks();
            showToast('已恢復為預設範本資料');
        }

        // 擷取網域名稱
        function extractDomain(url) {
            try {
                return new URL(url).hostname.replace('www.', '');
            } catch (e) {
                return url;
            }
        }

        // 防止 XSS 跳脫字元
        function escapeHTML(str) {
            return String(str).replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag]));
        }

        // 顯示 Toast 通知
        let toastTimeout;
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-msg');
            const iconEl = toast.querySelector('i');

            msgEl.textContent = message;
            iconEl.className = isError 
                ? 'fa-solid fa-circle-exclamation text-rose-400' 
                : 'fa-solid fa-circle-check text-emerald-400';

            toast.classList.remove('opacity-0', 'translate-y-4');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4');
            }, 3000);
        }

        // 啟動應用
        window.addEventListener('DOMContentLoaded', init);
    </script>
</body>
